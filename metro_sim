def parse_time(time_str):
    """
    Converts a time string like '09:30' into minutes from midnight.
    Example: '01:00' -> 60 minutes.
    """
    try:
        parts = time_str.split(':')
        hours = int(parts[0])
        minutes = int(parts[1])
        return hours * 60 + minutes
    except:
        return None
